def _touch_success(spark, dir_path):
    """写入成功后，在输出目录创建 _SUCCESS 标记文件。"""
    dir_path = dir_path.rstrip('/')
    full_uri = dir_path if dir_path.startswith('hdfs://') else HDFS_NS + dir_path
    jvm = spark.sparkContext._jvm
    conf = spark.sparkContext._jsc.hadoopConfiguration()
    uri = jvm.java.net.URI.create(full_uri)
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(uri, conf)
    success_path = jvm.org.apache.hadoop.fs.Path(uri.getPath() + '/_SUCCESS')
    out = fs.create(success_path, True)
    out.close()
    print('touch _SUCCESS:', full_uri + '/_SUCCESS')


def write_json_to_hdfs(spark, file_path, payload):
    """在 HDFS 上写一个 UTF-8 JSON 文件；调用方负责保证父目录存在。"""
    full_uri = file_path if file_path.startswith('hdfs://') else HDFS_NS + file_path
    jvm = spark.sparkContext._jvm
    conf = spark.sparkContext._jsc.hadoopConfiguration()
    uri = jvm.java.net.URI.create(full_uri)
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(uri, conf)
    path_obj = jvm.org.apache.hadoop.fs.Path(uri.getPath())
    output_stream = fs.create(path_obj, True)
    writer = jvm.java.io.OutputStreamWriter(output_stream, "UTF-8")
    try:
        writer.write(
            json.dumps(
                payload,
                ensure_ascii=False,
                sort_keys=True,
                indent=2,
            )
        )
        writer.write("\n")
    finally:
        writer.close()
    print("write sampling metadata:", full_uri)


def get_hdfs_data_file_stats(spark, dir_path):
    """统计输出目录中非下划线开头的数据文件数量和字节数。"""
    full_uri = dir_path if dir_path.startswith('hdfs://') else HDFS_NS + dir_path
    jvm = spark.sparkContext._jvm
    conf = spark.sparkContext._jsc.hadoopConfiguration()
    uri = jvm.java.net.URI.create(full_uri)
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(uri, conf)
    dir_obj = jvm.org.apache.hadoop.fs.Path(uri.getPath())

    file_count = 0
    total_bytes = 0
    if fs.exists(dir_obj):
        for status in fs.listStatus(dir_obj):
            name = status.getPath().getName()
            if status.isFile() and not name.startswith("_") and not name.startswith("."):
                file_count += 1
                total_bytes += int(status.getLen())

    return {
        "data_file_count": file_count,
        "data_file_total_bytes": total_bytes,
    }



def mapPartExtractx(iterator, cmd):
    input_lines = list(iterator)
    input_count = len(input_lines)
    input_data = "\n".join(input_lines)

    if input_data:
        input_data += "\n"

    process = subprocess.Popen(
        cmd,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )

    stdout, stderr = process.communicate(input_data)
    output_lines = stdout.splitlines()
    output_count = len(output_lines)

    output_ratio = (
        float(output_count) / float(input_count)
        if input_count > 0 else 1.0
    )

    stderr_head = (stderr or "")[-1000:].replace("\n", "\\n")

    # 无论成功失败都输出分区级审计信息
    print(
        "FEA_EXTRACT_AUDIT "
        "returncode=%d input_lines=%d output_lines=%d "
        "output_ratio=%.8f stderr_tail=%s"
        % (
            process.returncode,
            input_count,
            output_count,
            output_ratio,
            stderr_head,
        )
    )

    if process.returncode != 0:
        raise RuntimeError(
            "fea_extract failed: "
            "returncode=%d, input_lines=%d, output_lines=%d, stderr=%s"
            % (
                process.returncode,
                input_count,
                output_count,
                (stderr or "")[-4000:],
            )
        )

    if input_count > 0 and output_count == 0:
        raise RuntimeError(
            "fea_extract returned empty output for non-empty partition: "
            "input_lines=%d" % input_count
        )

    return output_lines

def diagnose_extract_line(iterator, cmd, field_names):
    """
    小批量诊断：每条样本单独调用一次 fea_extract。

    每条输入都会输出一条 JSON 诊断记录，但不会输出原始样本。
    """
    for line in iterator:
        fields = line.split("\t")
        traceid = fields[0] if fields else ""

        traceid_sha1 = hashlib.sha1(
            traceid.encode("utf-8", errors="ignore")
        ).hexdigest()

        process = subprocess.Popen(
            cmd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            universal_newlines=True,
        )

        stdout, stderr = process.communicate(line + "\n")

        output_lines = stdout.splitlines()
        stderr_text = stderr or ""

        if process.returncode != 0:
            status = "returncode_error"
        elif len(output_lines) == 0:
            status = "no_output"
        else:
            status = "success"

        empty_values = {"", "\\N", "null", "NULL", "None"}

        field_value_map = dict(zip(field_names, fields))
        new_field_names = NEW_PREFERENCE_FIELDS
        new_fields = [
            field_value_map.get(field_name, "")
            for field_name in new_field_names
        ]

        empty_new_fields = [
            name
            for name, value in zip(new_field_names, new_fields)
            if value in empty_values
        ]

        record = {
            "status": status,
            "is_cov_value": field_value_map.get("is_cov", ""),
            "label_value": field_value_map.get("label", ""),
            "traceid_sha1": traceid_sha1,
            "returncode": process.returncode,
            "input_column_count": len(fields),
            "output_line_count": len(output_lines),
            "stderr_line_count": len(stderr_text.splitlines()),
            "stderr": stderr_text[-8000:],
            "new_field_count": len(new_fields),
            "new_nonempty_count": sum(
                value not in empty_values
                for value in new_fields
            ),
            "empty_new_fields": empty_new_fields,
            "new_field_lengths": [
                len(value) for value in new_fields
            ],
        }

        yield (
            status,
            json.dumps(
                record,
                ensure_ascii=False,
                sort_keys=True,
            ),
        )

def parse_line(line):
    lis = line.split('#', 1)[0].strip(' \n').split(' ')
    cvr_label = float(lis[0])
    add_info_list = line.split('#', 1)[1].strip(' \n').split('\t')
    cat_label = float(add_info_list[9])
    clk_label = float(add_info_list[8])
    ext_label = float(add_info_list[15])
    fea_index = []
    fea_value = []
    for i, x in enumerate(lis[1:]):
        y = x.split(':')
        ind = int(y[0])
        val = int(y[1])
        fea_index.append(ind)
        fea_value.append(val)
    #add_info_list = [i.encode() for i in add_info_list]
    return fea_index, fea_value, cvr_label, cat_label, clk_label, ext_label,add_info_list


def _as_binary(value):
    try:
        return 1 if float(value) != 0.0 else 0
    except (TypeError, ValueError):
        return 0


def _as_int_or_zero(value):
    if value is None or value == "\\N" or str(value).strip() == "":
        return 0
    return int(float(value))


def sampling_audit_record(line, is_preprocessed):
    """解析 fea_extract/PreProcess 行，返回标签组合、曝光桶和预处理资格。"""
    splits = line.split('#', 1)
    if len(splits) < 2:
        raise ValueError("sampling audit line does not contain #")

    sparse_tokens = splits[0].strip().split(' ')
    add_info = splits[1].strip().split('\t')
    if not sparse_tokens or len(add_info) < 24:
        raise ValueError(
            "invalid sampling audit line: sparse=%d add_info=%d"
            % (len(sparse_tokens), len(add_info))
        )

    is_cov = _as_binary(sparse_tokens[0])
    is_clk = _as_binary(add_info[8])
    is_cat = _as_binary(add_info[9])

    if is_preprocessed:
        # PreProcess 已经把 add_info[15] 替换为派生后的 is_ext_label。
        is_ext_label = _as_binary(add_info[15])
    else:
        is_ext_cov = _as_int_or_zero(add_info[15])
        u_req_time = _as_int_or_zero(add_info[21])
        pay_timestamp = _as_int_or_zero(add_info[22])
        diff_time = 0
        if pay_timestamp > 0 and u_req_time > 0:
            diff_time = pay_timestamp - u_req_time
        is_ext_label = 1 if is_ext_cov == 1 and diff_time >= 0 else 0

    trace_imp_cnt = _as_int_or_zero(add_info[18])
    trace_bucket = "le_2" if trace_imp_cnt <= 2 else "gt_2"

    uid = add_info[5]
    u_nearby_imp_cnt = _as_int_or_zero(add_info[13])
    preprocess_eligible = not (
        u_nearby_imp_cnt > 1000 and uid != '0'
    )

    key = (
        is_cov,
        is_clk,
        is_cat,
        is_ext_label,
        trace_bucket,
    )
    return key, preprocess_eligible


def collect_extract_audit(rdd):
    """一次扫描同时收集 PreProcess 前的全量和确定性过滤后分布。"""
    pairs = rdd.map(
        lambda line: sampling_audit_record(line, False)
    ).map(
        lambda item: (
            item[0],
            (1, 1 if item[1] else 0),
        )
    ).reduceByKey(
        lambda left, right: (
            left[0] + right[0],
            left[1] + right[1],
        )
    ).collect()

    all_counts = {}
    eligible_counts = {}
    for key, counts in pairs:
        all_counts[key] = int(counts[0])
        eligible_counts[key] = int(counts[1])
    return all_counts, eligible_counts


def collect_preprocessed_audit(rdd):
    pairs = rdd.map(
        lambda line: (
            sampling_audit_record(line, True)[0],
            1,
        )
    ).reduceByKey(lambda left, right: left + right).collect()
    return {key: int(count) for key, count in pairs}


def summarize_sampling_groups(group_counts):
    total = int(sum(group_counts.values()))
    label_positive = {
        "is_cov": 0,
        "is_clk": 0,
        "is_cat": 0,
        "is_ext_label": 0,
    }
    all_zero = 0
    all_zero_le_2 = 0
    all_zero_gt_2 = 0
    combinations = []

    for key in sorted(group_counts):
        is_cov, is_clk, is_cat, is_ext_label, trace_bucket = key
        count = int(group_counts[key])
        label_positive["is_cov"] += count * is_cov
        label_positive["is_clk"] += count * is_clk
        label_positive["is_cat"] += count * is_cat
        label_positive["is_ext_label"] += count * is_ext_label

        is_all_zero = (
            is_cov == 0
            and is_clk == 0
            and is_cat == 0
            and is_ext_label == 0
        )
        if is_all_zero:
            all_zero += count
            if trace_bucket == "le_2":
                all_zero_le_2 += count
            else:
                all_zero_gt_2 += count

        combinations.append({
            "is_cov": is_cov,
            "is_clk": is_clk,
            "is_cat": is_cat,
            "is_ext_label": is_ext_label,
            "trace_imp_bucket": trace_bucket,
            "all_labels_zero": is_all_zero,
            "count": count,
        })

    return {
        "total": total,
        "label_positive_counts": label_positive,
        "all_labels_zero_count": all_zero,
        "any_label_positive_count": total - all_zero,
        "all_labels_zero_trace_le_2_count": all_zero_le_2,
        "all_labels_zero_trace_gt_2_count": all_zero_gt_2,
        "combinations": combinations,
    }


def build_retention_by_group(before_counts, after_counts):
    result = []
    for key in sorted(set(before_counts) | set(after_counts)):
        before = int(before_counts.get(key, 0))
        after = int(after_counts.get(key, 0))
        is_cov, is_clk, is_cat, is_ext_label, trace_bucket = key
        result.append({
            "is_cov": is_cov,
            "is_clk": is_clk,
            "is_cat": is_cat,
            "is_ext_label": is_ext_label,
            "trace_imp_bucket": trace_bucket,
            "all_labels_zero": (
                is_cov == 0
                and is_clk == 0
                and is_cat == 0
                and is_ext_label == 0
            ),
            "before_sampling_count": before,
            "after_sampling_count": after,
            "retention_rate": (
                float(after) / float(before)
                if before > 0 else None
            ),
        })
    return result

# 新增：HDFS工具函数，driver端执行
def hdfs_path_exists(spark, hdfs_full_path):
    jvm = spark.sparkContext._jvm
    conf = spark.sparkContext._jsc.hadoopConfiguration()
    uri = jvm.java.net.URI.create(hdfs_full_path)
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(uri, conf)
    path_obj = jvm.org.apache.hadoop.fs.Path(hdfs_full_path)
    return fs.exists(path_obj)


def list_hdfs_dir_files(spark, hdfs_full_dir):
    """列出HDFS目录下所有文件/子目录完整路径"""
    jvm = spark.sparkContext._jvm
    conf = spark.sparkContext._jsc.hadoopConfiguration()
    uri = jvm.java.net.URI.create(hdfs_full_dir)
    fs = jvm.org.apache.hadoop.fs.FileSystem.get(uri, conf)
    dir_path = jvm.org.apache.hadoop.fs.Path(hdfs_full_dir)
    if not fs.exists(dir_path):
        return []
    status_arr = fs.listStatus(dir_path)
    file_list = []
    for status in status_arr:
        file_list.append(str(status.getPath()))
    return file_list

