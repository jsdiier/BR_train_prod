DIAG_ONLY = False
DIAG_SAMPLE_SIZE = 1000


def row_to_fea_extract_line(row):
    """
    按 fea_cols_str 顺序生成 TSV。

    fea_extract 的分列逻辑不会保留行尾空字段，因此动态识别当前最后一列；
    如果最后一列为 NULL 或空字符串，统一补 0，避免整行少一列。
    """
    values = []

    for index, column_name in enumerate(cols):
        value = row[column_name]

        if index == len(cols) - 1:
            if value is None or str(value).strip() == "":
                value = 0

        values.append(
            "" if value is None else str(value)
        )

    return "\t".join(values)


def diagnostic_row_to_line(row):
    return row_to_fea_extract_line(row)


# DIAG_ONLY 在抽样及偏好特征关联完成后执行，确保诊断输入与正式输入一致。

# ------------------------------------------------------------------
# 阶段 1：Hive SQL 过滤后的原始样本
# ------------------------------------------------------------------
raw_df = spark.sql(filter_sql).persist(StorageLevel.DISK_ONLY)

raw_count = raw_df.count()
raw_stats_row = raw_df.agg(
    F.sum(
        F.when(F.col("is_cov").cast("double") > 0, 1).otherwise(0)
    ).alias("is_cov_positive"),
    F.sum(
        F.when(F.col("is_clk").cast("double") > 0, 1).otherwise(0)
    ).alias("is_clk_positive"),
    F.sum(
        F.when(F.col("is_cat").cast("double") > 0, 1).otherwise(0)
    ).alias("is_cat_positive"),
    F.sum(
        F.when(F.col("is_ext_cov").cast("double") > 0, 1).otherwise(0)
    ).alias("is_ext_cov_positive"),
    F.sum(
        F.when(
            F.col(base_last_input_column).isNull()
            | (F.trim(F.col(base_last_input_column).cast("string")) == ""),
            1,
        ).otherwise(0)
    ).alias("trailing_column_fill_count"),
).collect()[0]

raw_buy_positive = int(raw_stats_row["is_cov_positive"] or 0)
raw_label_positive_counts = {
    "is_cov": raw_buy_positive,
    "is_clk": int(raw_stats_row["is_clk_positive"] or 0),
    "is_cat": int(raw_stats_row["is_cat_positive"] or 0),
    "is_ext_cov": int(raw_stats_row["is_ext_cov_positive"] or 0),
}
trailing_column_fill_count = int(
    raw_stats_row["trailing_column_fill_count"] or 0
)

raw_buy_rate = (
    float(raw_buy_positive) / float(raw_count)
    if raw_count > 0 else 0.0
)

print(
    "PIPELINE_AUDIT RAW_SQL "
    "day=%s rows=%d cov_positive=%d cov_rate=%.8f "
    "trailing_column=%s trailing_fill_count=%d"
    % (
        dt,
        raw_count,
        raw_buy_positive,
        raw_buy_rate,
        base_last_input_column,
        trailing_column_fill_count,
    )
)

if raw_count == 0:
    raw_df.unpersist()
    raise RuntimeError(
        "Hive SQL returned zero rows for day %s" % dt
    )


# ------------------------------------------------------------------
# 阶段 2：基线确定性过滤及 BUY=0 伯努利抽样
# ------------------------------------------------------------------
overexposure_condition = (
    (F.coalesce(F.col("u_nearby_imp_cnt").cast("long"), F.lit(0)) > 1000)
    & (F.col("u_id").cast("string") != F.lit("0"))
)

sampling_eligible_df = (
    raw_df
    .filter(~overexposure_condition)
    .persist(StorageLevel.DISK_ONLY)
)
sampling_eligible_count = sampling_eligible_df.count()
overexposure_filtered_count = raw_count - sampling_eligible_count

buy_is_zero = (
    F.coalesce(F.col("is_cov").cast("double"), F.lit(0.0)) == 0.0
)

before_sampling_row = sampling_eligible_df.agg(
    F.sum(F.when(buy_is_zero, 1).otherwise(0)).alias("buy_zero"),
    F.sum(F.when(~buy_is_zero, 1).otherwise(0)).alias("buy_nonzero"),
).collect()[0]

sampled_df = (
    sampling_eligible_df
    .filter(
        (~buy_is_zero)
        | (F.rand() <= F.lit(BASELINE_NEGATIVE_SAMPLE_RATE))
    )
    .persist(StorageLevel.DISK_ONLY)
)

sampled_count = sampled_df.count()
after_sampling_row = sampled_df.agg(
    F.sum(F.when(buy_is_zero, 1).otherwise(0)).alias("buy_zero"),
    F.sum(F.when(~buy_is_zero, 1).otherwise(0)).alias("buy_nonzero"),
).collect()[0]

buy_zero_before = int(before_sampling_row["buy_zero"] or 0)
buy_nonzero_before = int(before_sampling_row["buy_nonzero"] or 0)
buy_zero_after = int(after_sampling_row["buy_zero"] or 0)
buy_nonzero_after = int(after_sampling_row["buy_nonzero"] or 0)

baseline_sampling_audit = {
    "eligible_rows": sampling_eligible_count,
    "overexposure_filtered_rows": overexposure_filtered_count,
    "buy_zero_before": buy_zero_before,
    "buy_zero_after": buy_zero_after,
    "buy_zero_retention_rate": (
        float(buy_zero_after) / float(buy_zero_before)
        if buy_zero_before > 0 else None
    ),
    "buy_nonzero_before": buy_nonzero_before,
    "buy_nonzero_after": buy_nonzero_after,
    "buy_nonzero_retention_rate": (
        float(buy_nonzero_after) / float(buy_nonzero_before)
        if buy_nonzero_before > 0 else None
    ),
    "sampled_rows": sampled_count,
}

print(
    "PIPELINE_AUDIT BASELINE_SAMPLING "
    + json.dumps(baseline_sampling_audit, sort_keys=True)
)

sampling_eligible_df.unpersist()
raw_df.unpersist()

if sampled_count == 0:
    sampled_df.unpersist()
    raise RuntimeError("baseline sampling returned zero rows for day %s" % dt)


# ------------------------------------------------------------------
# 阶段 3：抽样后按 u_id LEFT JOIN D-1 用户偏好特征
# ------------------------------------------------------------------
preference_df = spark.sql(preference_sql)

joined_df = (
    sampled_df.alias("sample")
    .join(
        preference_df.alias("preference"),
        F.col("sample.u_id").cast("string")
        == F.col("preference.preference_uid"),
        "left",
    )
    .select(
        *[F.col("sample.%s" % field_name).alias(field_name)
          for field_name in BASE_FEATURE_FIELDS],
        F.when(
            F.col("preference.preference_uid").isNotNull(),
            F.lit(1),
        ).otherwise(F.lit(0)).alias("__preference_matched"),
        *[
            F.coalesce(
                F.col("preference.%s" % field_name).cast("string"),
                F.lit(""),
            ).alias(field_name)
            for field_name in NEW_PREFERENCE_FIELDS
        ]
    )
    .persist(StorageLevel.DISK_ONLY)
)

joined_count = joined_df.count()
if joined_count != sampled_count:
    joined_df.unpersist()
    sampled_df.unpersist()
    raise RuntimeError(
        "LEFT JOIN changed row count: sampled=%d joined=%d; "
        "preference table may contain duplicate uid rows"
        % (sampled_count, joined_count)
    )


def nonempty_feature_expr(field_name):
    normalized = F.trim(F.col(field_name).cast("string"))
    invalid_values = ["", "\\N"]
    if field_name in SHOP_ID_FIELDS:
        invalid_values.extend(["0", "-1"])
    return (~normalized.isin(invalid_values)) & normalized.isNotNull()


def collect_coverage_metrics(dataframe, denominator_name):
    expressions = [
        F.count(F.lit(1)).alias("denominator"),
        F.sum(F.col("__preference_matched")).alias("matched"),
    ]
    for field_name in NEW_PREFERENCE_FIELDS:
        expressions.append(
            F.sum(
                F.when(nonempty_feature_expr(field_name), 1).otherwise(0)
            ).alias(field_name)
        )

    row = dataframe.agg(*expressions).collect()[0]
    denominator = int(row["denominator"] or 0)
    matched = int(row["matched"] or 0)
    feature_metrics = {}
    for field_name in NEW_PREFERENCE_FIELDS:
        covered = int(row[field_name] or 0)
        feature_metrics[field_name] = {
            "covered": covered,
            "coverage_over_all": (
                float(covered) / float(denominator)
                if denominator > 0 else None
            ),
            "coverage_among_matched": (
                float(covered) / float(matched)
                if matched > 0 else None
            ),
        }
    return {
        "denominator_name": denominator_name,
        "denominator": denominator,
        "matched": matched,
        "join_coverage": (
            float(matched) / float(denominator)
            if denominator > 0 else None
        ),
        "features": feature_metrics,
    }


sample_row_coverage = collect_coverage_metrics(joined_df, "sample_rows")
joined_user_df = joined_df.dropDuplicates(["u_id"]).persist(
    StorageLevel.DISK_ONLY
)
sample_user_coverage = collect_coverage_metrics(
    joined_user_df,
    "distinct_sample_users",
)

sequence_length_df = joined_user_df.select(
    *[
        F.when(
            nonempty_feature_expr(field_name),
            F.size(F.split(F.col(field_name), ",")),
        ).otherwise(F.lit(0)).alias(field_name + "__length")
        for field_name in SEQUENCE_FIELDS
    ]
)

sequence_length_exprs = []
for field_name in SEQUENCE_FIELDS:
    length_column = field_name + "__length"
    sequence_length_exprs.extend([
        F.min(length_column).alias(field_name + "__min"),
        F.expr(
            "percentile_approx(%s, 0.5)" % length_column
        ).alias(field_name + "__p50"),
        F.expr(
            "percentile_approx(%s, 0.9)" % length_column
        ).alias(field_name + "__p90"),
        F.expr(
            "percentile_approx(%s, 0.99)" % length_column
        ).alias(field_name + "__p99"),
        F.max(length_column).alias(field_name + "__max"),
        F.sum(
            F.when(F.col(length_column) > 100, 1).otherwise(0)
        ).alias(field_name + "__over_100"),
    ])

sequence_length_row = sequence_length_df.agg(
    *sequence_length_exprs
).collect()[0]
sequence_length_audit = {
    field_name: {
        statistic: int(
            sequence_length_row[field_name + "__" + statistic] or 0
        )
        for statistic in ["min", "p50", "p90", "p99", "max", "over_100"]
    }
    for field_name in SEQUENCE_FIELDS
}

print(
    "PIPELINE_AUDIT PREFERENCE_ROW_COVERAGE "
    + json.dumps(sample_row_coverage, sort_keys=True)
)
print(
    "PIPELINE_AUDIT PREFERENCE_USER_COVERAGE "
    + json.dumps(sample_user_coverage, sort_keys=True)
)
print(
    "PIPELINE_AUDIT PREFERENCE_SEQUENCE_LENGTH "
    + json.dumps(sequence_length_audit, sort_keys=True)
)

joined_user_df.unpersist()
sampled_df.unpersist()

final_input_df = joined_df.select(*cols).persist(StorageLevel.DISK_ONLY)
final_input_count = final_input_df.count()
joined_df.unpersist()

if final_input_count != sampled_count:
    final_input_df.unpersist()
    raise RuntimeError(
        "final input row count mismatch: sampled=%d final_input=%d"
        % (sampled_count, final_input_count)
    )


if DIAG_ONLY:
    print(
        "FEA_EXTRACT_LINE_DIAG start day=%s sample_size=%d"
        % (dt, DIAG_SAMPLE_SIZE)
    )
    diagnostic_input_rdd = (
        final_input_df.limit(DIAG_SAMPLE_SIZE)
        .rdd.map(diagnostic_row_to_line)
    )
    diagnostic_pair_rdd = diagnostic_input_rdd.mapPartitions(
        lambda part: diagnose_extract_line(
            part,
            ["./fea_extract", "./parse.conf"],
            cols,
        )
    ).persist(StorageLevel.DISK_ONLY)
    diagnostic_counts = dict(
        diagnostic_pair_rdd.map(lambda item: (item[0], 1))
        .reduceByKey(lambda left, right: left + right)
        .collect()
    )
    diagnostic_path = (
        OUTPUT_ROOT.rstrip("/") + "/_diagnostics/" + dt
        + "_fea_extract_line_results"
    )
    spark.createDataFrame(
        diagnostic_pair_rdd.map(lambda item: (item[1],)),
        ["value"],
    ).coalesce(1).write.mode("overwrite").text(diagnostic_path)
    print(
        "FEA_EXTRACT_LINE_DIAG completed day=%s counts=%s output=%s"
        % (dt, json.dumps(diagnostic_counts, sort_keys=True),
           HDFS_NS + diagnostic_path)
    )
    diagnostic_pair_rdd.unpersist()
    final_input_df.unpersist()
    sys.exit(0)


def hive_df_to_lines(partition):
    for row in partition:
        yield row_to_fea_extract_line(row)


# ------------------------------------------------------------------
# 阶段 4：fea_extract 处理后的样本
# ------------------------------------------------------------------
input_rdd = final_input_df.rdd.mapPartitions(hive_df_to_lines)

extract_rdd = input_rdd.mapPartitions(
    lambda part: mapPartExtractx(
        part,
        ["./fea_extract", "./parse.conf"],
    )
).persist(StorageLevel.DISK_ONLY)

extract_count = extract_rdd.count()

extract_ratio = (
    float(extract_count) / float(final_input_count)
    if final_input_count > 0 else 0.0
)

print(
    "PIPELINE_AUDIT AFTER_EXTRACT "
    "day=%s input_rows=%d output_rows=%d output_ratio=%.8f"
    % (
        dt,
        final_input_count,
        extract_count,
        extract_ratio,
    )
)

# extract_rdd 已经物化，可以释放关联后输入缓存
final_input_df.unpersist()

if extract_count == 0:
    extract_rdd.unpersist()
    raise RuntimeError(
        "fea_extract returned zero rows for day %s" % dt
    )

extract_group_counts, unused_eligible_group_counts = collect_extract_audit(
    extract_rdd
)
extract_group_summary = summarize_sampling_groups(extract_group_counts)

print(
    "PIPELINE_AUDIT AFTER_EXTRACT_LABELS "
    "day=%s rows=%d buy_positive=%d click_positive=%d "
    "cat_positive=%d ext_positive=%d"
    % (
        dt,
        extract_group_summary["total"],
        extract_group_summary["label_positive_counts"]["is_cov"],
        extract_group_summary["label_positive_counts"]["is_clk"],
        extract_group_summary["label_positive_counts"]["is_cat"],
        extract_group_summary["label_positive_counts"]["is_ext_label"],
    )
)


# ------------------------------------------------------------------
# 阶段 5：PreProcess 标签修正（禁止再次抽样）
# ------------------------------------------------------------------
pre = PreProcess(
    is_test=False,
    **PREPROCESS_CONFIG
)

preprocessed_rdd = (
    extract_rdd
    .map(pre.parse_line)
    .filter(lambda x: x is not None)
    .persist(StorageLevel.DISK_ONLY)
)

preprocess_count = preprocessed_rdd.count()

preprocessed_group_counts = collect_preprocessed_audit(
    preprocessed_rdd
)
preprocessed_group_summary = summarize_sampling_groups(
    preprocessed_group_counts
)
retention_by_group = build_retention_by_group(
    extract_group_counts,
    preprocessed_group_counts,
)

preprocess_ratio = (
    float(preprocess_count) / float(extract_count)
    if extract_count > 0 else 0.0
)

print(
    "PIPELINE_AUDIT AFTER_PREPROCESS "
    "day=%s input_rows=%d output_rows=%d output_ratio=%.8f "
    "post_extract_sampling_enabled=%s"
    % (
        dt,
        extract_count,
        preprocess_count,
        preprocess_ratio,
        pre.enable_sample,
    )
)

# 预处理结果已物化，可以释放 extract_rdd
extract_rdd.unpersist()

if preprocess_count == 0:
    preprocessed_rdd.unpersist()
    raise RuntimeError(
        "PreProcess returned zero rows for day %s" % dt
    )


# ------------------------------------------------------------------
# 阶段 6：转换为最终 TFRecord schema
# ------------------------------------------------------------------
parsed_rdd = (
    preprocessed_rdd
    .map(parse_line)
    .persist(StorageLevel.DISK_ONLY)
)

final_count = parsed_rdd.count()

print(
    "PIPELINE_AUDIT FINAL_PARSED "
    "day=%s input_rows=%d output_rows=%d output_ratio=%.8f"
    % (
        dt,
        preprocess_count,
        final_count,
        (
            float(final_count) / float(preprocess_count)
            if preprocess_count > 0 else 0.0
        ),
    )
)

preprocessed_rdd.unpersist()

if final_count == 0:
    parsed_rdd.unpersist()
    raise RuntimeError(
        "Final parsed RDD contains zero rows for day %s" % dt
    )


schema = StructType([
    StructField("fea_ids", ArrayType(LongType())),
    StructField("fea_vals", ArrayType(LongType())),
    StructField("cvr_label", FloatType()),
    StructField("cat_label", FloatType()),
    StructField("clk_label", FloatType()),
    StructField("ext_label", FloatType()),
    StructField("add_info_list", ArrayType(StringType())),
])

output_df = spark.createDataFrame(
    parsed_rdd,
    schema=schema,
)

# 必须与前面的 target_output_dir 使用同一个新目录
output_path = target_output_dir

print(
    "PIPELINE_AUDIT WRITE_BEGIN "
    "day=%s rows=%d output=%s"
    % (
        dt,
        final_count,
        HDFS_NS + output_path,
    )
)

(
    output_df
    .repartition(10)
    .write
    .mode("overwrite")
    .format("tfrecord")
    .option("recordType", "Example")
    .option("codec", "org.apache.hadoop.io.compress.GzipCodec")
    .save(output_path)
)

print(
    "数据写入成功,精确写入条数:",
    dt,
    final_count,
)

output_file_stats = get_hdfs_data_file_stats(spark, output_path)
pipeline_end_epoch = time.time()
pipeline_end_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

sampling_metadata = {
    "pipeline": {
        "version": PIPELINE_VERSION,
        "spark_application_id": spark.sparkContext.applicationId,
        "start_time": pipeline_start_time,
        "end_time": pipeline_end_time,
        "duration_seconds": round(
            pipeline_end_epoch - pipeline_start_epoch,
            3,
        ),
    },
    "partition": {
        "biz_date": biz_date,
        "data_date": dt,
        "source_table": SOURCE_TABLE,
        "preference_date": preference_dt,
        "preference_table": PREFERENCE_TABLE,
        "output_path": HDFS_NS + output_path,
    },
    "input_schema": {
        "feature_column_count": len(cols),
        "baseline_feature_column_count": len(BASE_FEATURE_FIELDS),
        "new_preference_feature_count": len(NEW_PREFERENCE_FIELDS),
        "new_preference_fields": NEW_PREFERENCE_FIELDS,
        "first_column": cols[0],
        "last_column": last_input_column,
        "trailing_column_default": "0",
        "trailing_column_fill_count": trailing_column_fill_count,
    },
    "filters": {
        "sql": [
            "u_channel = '0'",
            "u_id NOT IN ('0', '-1')",
            "is_imp = '1'",
            "hit_code = '0'",
        ],
        "preprocess": [
            "drop before join when u_nearby_imp_cnt > 1000 and u_id != '0'",
        ],
        "preprocess_filtered_count": overexposure_filtered_count,
    },
    "sampling": {
        "enabled": True,
        "stage": "before_preference_left_join_and_before_fea_extract",
        "method": "spark_rand_bernoulli",
        "random_seed": None,
        "baseline_pos_rate": BASELINE_POS_RATE,
        "baseline_rate": BASELINE_RATE,
        "negative_sample_rate": BASELINE_NEGATIVE_SAMPLE_RATE,
        "primary_label": "is_cov",
        "rule": "sample only when is_cov == 0; retain all is_cov != 0",
        "post_extract_sampling_enabled": pre.enable_sample,
        "is_ext_label_rule": (
            "is_ext_cov == 1 and "
            "derived(pay_timestamp - u_req_time) >= 0"
        ),
    },
    "stage_counts": {
        "raw_sql": raw_count,
        "sampling_eligible": sampling_eligible_count,
        "after_baseline_sampling": sampled_count,
        "after_preference_left_join": joined_count,
        "final_extract_input": final_input_count,
        "after_fea_extract": extract_count,
        "after_preprocess": preprocess_count,
        "final_parsed": final_count,
    },
    "stage_ratios": {
        "sampling_eligible_over_raw": (
            float(sampling_eligible_count) / float(raw_count)
            if raw_count > 0 else None
        ),
        "sampled_over_sampling_eligible": (
            float(sampled_count) / float(sampling_eligible_count)
            if sampling_eligible_count > 0 else None
        ),
        "preference_join_row_conservation": (
            float(joined_count) / float(sampled_count)
            if sampled_count > 0 else None
        ),
        "fea_extract_over_final_input": extract_ratio,
        "final_over_preprocessed": (
            float(final_count) / float(preprocess_count)
            if preprocess_count > 0 else None
        ),
    },
    "raw_label_positive_counts": raw_label_positive_counts,
    "preference_coverage": {
        "sample_rows": sample_row_coverage,
        "distinct_sample_users": sample_user_coverage,
        "sequence_lengths": sequence_length_audit,
    },
    "label_distribution": {
        "after_fea_extract": extract_group_summary,
        "after_post_extract_transform": preprocessed_group_summary,
    },
    "sampling_result": {
        "baseline_sampling": baseline_sampling_audit,
        "post_extract_transform_by_label_and_trace_bucket": retention_by_group,
    },
    "output": output_file_stats,
}

write_json_to_hdfs(
    spark,
    output_path.rstrip("/") + "/" + SAMPLING_METADATA_FILENAME,
    sampling_metadata,
)

_touch_success(spark, output_path)

parsed_rdd.unpersist()

print(
    "PIPELINE_AUDIT COMPLETED "
    "day=%s preference_day=%s raw=%d sampled=%d joined=%d "
    "extracted=%d preprocessed=%d final=%d output=%s"
    % (
        dt,
        preference_dt,
        raw_count,
        sampled_count,
        joined_count,
        extract_count,
        preprocess_count,
        final_count,
        HDFS_NS + output_path,
    )
)
