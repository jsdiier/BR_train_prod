# 与 EVE 基线保持一致：仅 BUY 主标签为 0 的样本参与伯努利抽样。
BASELINE_POS_RATE = 0.0032
BASELINE_RATE = 5.0
BASELINE_NEGATIVE_SAMPLE_RATE = (
    BASELINE_POS_RATE / (1.0 - BASELINE_POS_RATE) * BASELINE_RATE
)

# 随机抽样已前移到 LEFT JOIN 之前；PreProcess 只负责原有的标签修正和
# 可选的 slot 过滤/归一化，严禁在 fea_extract 后再次抽样。
PREPROCESS_CONFIG = {
    'enable_sample': False,
    'negative_sample_rate': BASELINE_NEGATIVE_SAMPLE_RATE,
    'enable_fea_filt': False,    # 是否过滤 slot
    'filt_slot_set': set(),      # 需过滤的 slot 集合，如 {100, 101}
    'enable_zscore': False,      # 是否 z-score 归一化
    'zs_dic': {},                # {slot: (mean, std), ...}
}


class PreProcess:
    """特征预处理：负采样、slot 过滤、z-score 归一化。"""

    def __init__(
        self,
        is_test=False,
        enable_sample=True,
        negative_sample_rate=BASELINE_NEGATIVE_SAMPLE_RATE,
        enable_fea_filt=False,
        filt_slot_set=None,
        enable_zscore=False,
        zs_dic=None,
    ):
        self.is_test = is_test
        self.enable_sample = enable_sample
        self.negative_sample_rate = float(negative_sample_rate)

        if not 0.0 <= self.negative_sample_rate <= 1.0:
            raise ValueError(
                "negative_sample_rate must be in [0, 1], actual=%s"
                % self.negative_sample_rate
            )

        self.need_filt_slot = enable_fea_filt and bool(filt_slot_set)
        self.need_normalize = enable_zscore and bool(zs_dic)
        self.filt_slot_set = filt_slot_set or set()
        self.zs_dic = zs_dic or {}
        # 保留 r 属性，兼容审计输出；本任务中 enable_sample 必须为 False。
        self.r = self.negative_sample_rate if self.enable_sample else 0.0

    def neg_samplling(self, rate):
        return random.random() <= rate

    def normal(self, slot, val, zs_dic):
        if slot in zs_dic:
            mean, std = zs_dic[slot]
            return (val - mean) / std
        return val

    def _transform_features(self, lis):
        out_lis = [lis[0]]
        for i in range(1, len(lis)):
            li = lis[i].split(':')
            if len(li) != 2:
                out_lis.append(lis[i])
                continue
            slot = int(li[0])
            val = float(li[1])
            if self.need_normalize:
                val = self.normal(slot, val, self.zs_dic)
            if self.need_filt_slot and slot in self.filt_slot_set:
                continue
            out_lis.append('%s:%s' % (slot, val))
        return ' '.join(out_lis)

    def parse_line(self, line0):
        splits = line0.split('#', 1)
        if len(splits) < 2:
            return None
        line = splits[0].strip()
        add_i = splits[1].strip()
        if line == '':
            return None

        lis = line.split(' ')
        label = lis[0]
        add_info = add_i.split('\t')

        if len(add_info) < 24:
            raise ValueError(
                "add_info requires at least 24 columns, actual=%d"
                % len(add_info)
            )

        if self.is_test:
            return str(line) + '#' + str(add_i)

        uid = add_info[5]
        is_clk_label = add_info[8]
        is_cat_label = add_info[9]
        u_nearby_imp_cnt = int(add_info[13])
        is_ext_cov = int(add_info[15])

        u_req_time = add_info[21]
        if u_req_time is not None and u_req_time != '\\N':
            u_req_time = int(u_req_time)
        else:
            u_req_time = 0

        pay_timestamp = add_info[22]
        if pay_timestamp is not None and pay_timestamp != '\\N':
            pay_timestamp = int(pay_timestamp)
        else:
            pay_timestamp = 0

        diff_time = 0
        if pay_timestamp > 0 and u_req_time > 0:
            diff_time = pay_timestamp - u_req_time

        add_list = add_info[:15]
        if u_nearby_imp_cnt > 1000 and uid != '0':
            return None

        is_ext_label = '0'
        if is_ext_cov == 1 and diff_time >= 0:
            is_ext_label = '1'

        add_list.append(is_ext_label)
        add_list.extend(add_info[16:])
        add_i = '\t'.join(add_list)

        if self.enable_sample:
            raise RuntimeError(
                "sampling must run before preference LEFT JOIN; "
                "post-extract sampling would sample negatives twice"
            )

        if not self.need_filt_slot and not self.need_normalize:
            return line + '#' + add_i
        return self._transform_features(lis) + '#' + add_i

