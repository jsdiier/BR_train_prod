"""

preference_sql = f"""
SELECT
    CAST(uid AS STRING) AS preference_uid,
    {','.join(NEW_PREFERENCE_FIELDS)}
FROM {PREFERENCE_TABLE}
WHERE
    dt = '{preference_dt}'
    AND country_code = 'BR'
"""

