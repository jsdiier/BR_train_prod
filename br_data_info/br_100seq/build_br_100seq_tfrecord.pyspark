# ========== 下推过滤条件到 SQL ==========
filter_sql = f"""
SELECT {','.join(BASE_FEATURE_FIELDS)}
FROM {SOURCE_TABLE}
WHERE
    u_channel = '0'
    AND u_id NOT IN ('0', '-1')
    AND is_imp = '1'
